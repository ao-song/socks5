{erl_opts, [debug_info,
            {i, "./src/"}]}.

%% Pure-Erlang Kerberos V5 / GSS-API, used for the gssapi auth method.
{deps, [{kerlberos, "2.0.3"}]}.

{relx, [{release, { socks5, "0.1.0" },
         [socks5, kerlberos, kernel, stdlib, sasl]},

        {sys_config, "./config/sys.config"},
        {vm_args, "./config/vm.args"},

        {dev_mode, true},
        {include_erts, false},

        {extended_start_script, true}]
}.

{profiles, [{prod, [{relx, [{dev_mode, false},
                            {include_erts, true}]}]
            }]
}.
