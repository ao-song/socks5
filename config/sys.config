[{socks5, [
    {socks5_port, 1080},

    %% Listen on one address only. Default: all interfaces, IPv4 and IPv6.
    %% {socks5_ip, {0,0,0,0}},

    %% Username/password (RFC 1929) accounts.
    {socks5_users, [{"testuser", "testpass"}]},

    %% GSS-API (RFC 1961) with Kerberos V5. Needs a keytab holding the
    %% key for the service principal clients ask for (socks/<host>@REALM
    %% unless the client is configured otherwise).
    %% levels: per-message protection levels the server agrees to;
    %% 0 none, 1 integrity, 2 confidentiality (3 is treated as 2).
    %% {socks5_gssapi, #{keytab => "/etc/krb5.keytab", levels => [0, 1, 2]}},

    %% Methods offered to clients, in preference order. Default: gssapi
    %% when socks5_gssapi is set, username_password when socks5_users is
    %% non-empty, otherwise no_auth.
    %% {socks5_auth_methods, [gssapi, username_password, no_auth]},

    %% Close a CONNECT/BIND/UDP relay after this many ms without traffic.
    {socks5_idle_timeout, 600000}
]},
{logger, [
    {handlers, [
        {default, logger_std_h, #{
            formatter => {logger_formatter, #{template => [time, " ", level, " ", msg, "\n"]}},
            level => debug
        }}
    ]}
]}].
